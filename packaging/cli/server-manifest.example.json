{
  "schemaVersion": 1,
  "profile": {
    "restorePreserve": [
      "session.lock",
      "xaeromap.txt",
      "soul_archive.json",
      "voxy",
      "DistantHorizons.sqlite",
      "DistantHorizons.sqlite-shm",
      "DistantHorizons.sqlite-wal"
    ]
  },
  "configs": [
    {
      "configId": "11111111-1111-4111-8111-111111111111",
      "name": "Minecraft Server",
      "saveRoot": "server",
      "backupRoot": "backups",
      "worlds": [
        {
          "path": "world",
          "description": "Primary world"
        }
      ],
      "backup": {
        "mode": "smart",
        "skipIfUnchanged": true,
        "maxSmartBackupsPerFull": 5
      },
      "archive": {
        "tool": "",
        "format": "7z",
        "method": "LZMA2",
        "level": 5,
        "threads": 0,
        "lowPriority": true
      },
      "retention": {
        "keepCount": 14
      },
      "restore": {
        "backupBefore": true
      },
      "exclude": [
        "session.lock",
        "logs"
      ],
      "cloud": {
        "enabled": false,
        "rclone": "",
        "remote": "",
        "mode": "history-only",
        "workingDirectory": "",
        "timeoutSeconds": 600,
        "retryCount": 1,
        "syncHistoryAfterUpload": true
      }
    }
  ],
  "jobs": [
    {
      "jobId": "22222222-2222-4222-8222-222222222222",
      "name": "Backup all worlds",
      "stages": [
        {
          "stageId": "33333333-3333-4333-8333-333333333333",
          "name": "Backup",
          "steps": [
            {
              "stepId": "44444444-4444-4444-8444-444444444444",
              "name": "Backup primary world",
              "type": "backup",
              "target": {
                "configId": "11111111-1111-4111-8111-111111111111",
                "worldPath": "world"
              },
              "comment": "Scheduled server backup"
            }
          ]
        }
      ]
    }
  ]
}

#define MINEBACKUP_VERSION_COMMA @MINEBACKUP_VERSION_MAJOR@,@MINEBACKUP_VERSION_MINOR@,@MINEBACKUP_VERSION_PATCH@,@MINEBACKUP_VERSION_TWEAK@

VS_VERSION_INFO VERSIONINFO
 FILEVERSION MINEBACKUP_VERSION_COMMA
 PRODUCTVERSION MINEBACKUP_VERSION_COMMA
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName", "Leafuke\0"
            VALUE "FileDescription", "MineBackup\0"
            VALUE "FileVersion", "@MINEBACKUP_VERSION@\0"
            VALUE "InternalName", "MineBackup\0"
            VALUE "LegalCopyright", "Copyright (C) MineBackup contributors\0"
            VALUE "OriginalFilename", "MineBackup.exe\0"
            VALUE "ProductName", "MineBackup\0"
            VALUE "ProductVersion", "@MINEBACKUP_VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END

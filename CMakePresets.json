{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 22, "patch": 0 },
  "configurePresets": [
    {
      "name": "windows-msvc-x64",
      "displayName": "Windows MSVC x64",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/windows-msvc-x64",
      "cacheVariables": { "MINEBACKUP_ENABLE_V15_MIGRATION": "ON" }
    },
    {
      "name": "linux-x64",
      "displayName": "Linux x86_64",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-x64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "MINEBACKUP_ENABLE_V15_MIGRATION": "ON"
      }
    },
    {
      "name": "macos-arm64",
      "displayName": "macOS arm64",
      "generator": "Xcode",
      "architecture": { "value": "arm64", "strategy": "external" },
      "binaryDir": "${sourceDir}/build/macos-arm64",
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "15.0",
        "MINEBACKUP_ENABLE_V15_MIGRATION": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-msvc-x64-release",
      "configurePreset": "windows-msvc-x64",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "windows-msvc-x64-release",
      "configurePreset": "windows-msvc-x64",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "linux-x64",
      "configurePreset": "linux-x64",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "macos-arm64",
      "configurePreset": "macos-arm64",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    }
  ]
}
